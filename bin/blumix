#!/usr/bin/env bash
# BLUMIX · Centro de Mando modular.
set -o pipefail
BLUMIX_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$BLUMIX_ROOT/lib/core.sh"
source "$BLUMIX_ROOT/lib/ui.sh"
source "$BLUMIX_ROOT/lib/system.sh"
source "$BLUMIX_ROOT/lib/network.sh"
source "$BLUMIX_ROOT/lib/security.sh"
source "$BLUMIX_ROOT/lib/audit.sh"
source "$BLUMIX_ROOT/lib/policy.sh"
source "$BLUMIX_ROOT/lib/development.sh"
source "$BLUMIX_ROOT/lib/integrations.sh"
source "$BLUMIX_ROOT/lib/intelligence.sh"
source "$BLUMIX_ROOT/lib/evidence.sh"
blumix_load_config

blumix_status() {
    local cpu ram disk cl="NO" sec="NO" elx="NO"
    cpu="$(blx_cpu_pct)"
    ram="$(free 2>/dev/null | awk '/^Mem:/ {if ($2>0) printf "%.0f", ($3/$2)*100}')"
    disk="$(df -P / 2>/dev/null | awk 'NR==2 {gsub("%","",$5); print $5}')"
    blumix_dir_exists "$BLUMCL_HOME" && cl="SÍ"
    blumix_dir_exists "$BLUMSEC_HOME" && sec="SÍ"
    blumix_dir_exists "$BLUMELIX_HOME" && elx="SÍ"
    printf 'BLUMIX %s | CPU %s%% | RAM %s%% | DISCO %s%% | BLUMCL %s | BLUMSEC %s | BLUMELIX %s\n' \
        "$BLUMIX_VERSION" "${cpu:-?}" "${ram:-?}" "${disk:-?}" "$cl" "$sec" "$elx"
}

blumix_report_json() {
    # Snapshot reducido: sin usuario, hostname, rutas absolutas, variables
    # de entorno, secretos ni contenido de archivos.
    local os kernel cpu_model generated uptime_seconds cpu_pct
    local mem_total_kb mem_available_kb mem_used_kb mem_total_bytes mem_used_bytes mem_pct
    local disk_pct cl=false sec=false elx=false
    local os_json kernel_json cpu_model_json generated_json

    os="$(. /etc/os-release 2>/dev/null; printf '%s' "${PRETTY_NAME:-Linux no identificado}")"
    kernel="$(uname -r 2>/dev/null || printf 'no-disponible')"
    generated="$(date -Is 2>/dev/null || date -u '+%Y-%m-%dT%H:%M:%SZ')"
    uptime_seconds="$(awk '{printf "%.0f", $1}' /proc/uptime 2>/dev/null)"
    cpu_pct="$(blx_cpu_pct 2>/dev/null || true)"
    cpu_model="$(lscpu 2>/dev/null | awk -F: '/Model name|Nombre del modelo/ {gsub(/^[[:space:]]+/, "", $2); if ($2 != "") {print $2; exit}}')"
    if [[ -z "$cpu_model" ]]; then
        cpu_model="$(awk -F: '/model name/ {gsub(/^[[:space:]]+/, "", $2); if ($2 != "") {print $2; exit}}' /proc/cpuinfo 2>/dev/null)"
    fi
    [[ -n "$cpu_model" ]] || cpu_model="no-disponible"

    mem_total_kb="$(awk '/^MemTotal:/ {print $2; exit}' /proc/meminfo 2>/dev/null)"
    mem_available_kb="$(awk '/^MemAvailable:/ {print $2; exit}' /proc/meminfo 2>/dev/null)"
    mem_total_bytes=null
    mem_used_bytes=null
    mem_pct=null
    if [[ "$mem_total_kb" =~ ^[0-9]+$ && "$mem_available_kb" =~ ^[0-9]+$ ]] && (( mem_total_kb > 0 )); then
        (( mem_available_kb > mem_total_kb )) && mem_available_kb=$mem_total_kb
        mem_used_kb=$((mem_total_kb - mem_available_kb))
        mem_total_bytes=$((mem_total_kb * 1024))
        mem_used_bytes=$((mem_used_kb * 1024))
        mem_pct=$((mem_used_kb * 100 / mem_total_kb))
    fi

    disk_pct="$(df -P / 2>/dev/null | awk 'NR==2 {gsub(/%/, "", $5); print $5}')"
    [[ "$cpu_pct" =~ ^[0-9]+$ ]] || cpu_pct=null
    [[ "$uptime_seconds" =~ ^[0-9]+$ ]] || uptime_seconds=null
    [[ "$disk_pct" =~ ^[0-9]+$ ]] || disk_pct=null
    [[ -d "$BLUMCL_HOME" ]] && cl=true
    [[ -d "$BLUMSEC_HOME" ]] && sec=true
    [[ -d "$BLUMELIX_HOME" ]] && elx=true

    os_json="$(blumix_json_quote "$os")"
    kernel_json="$(blumix_json_quote "$kernel")"
    cpu_model_json="$(blumix_json_quote "$cpu_model")"
    generated_json="$(blumix_json_quote "$generated")"

    cat <<JSON
{
  "schema": "blumix.snapshot.v1",
  "generated_at": $generated_json,
  "blumix_version": "$(printf '%s' "$BLUMIX_VERSION")",
  "system": {
    "os": $os_json,
    "kernel": $kernel_json,
    "cpu_model": $cpu_model_json,
    "cpu_percent": $cpu_pct,
    "uptime_seconds": $uptime_seconds,
    "memory_total_bytes": $mem_total_bytes,
    "memory_used_bytes": $mem_used_bytes,
    "memory_percent": $mem_pct,
    "root_disk_percent": $disk_pct
  },
  "integrations": {
    "BLUMCL": {"directory_found": $cl},
    "BLUMSEC": {"directory_found": $sec},
    "BLUMELIX": {"directory_found": $elx}
  },
  "safety": {
    "absolute_paths_included": false,
    "secrets_included": false,
    "live_service_health_checked": false
  }
}
JSON
}

blumix_about() {
    printf '\n%bBLUMIX — Centro de Mando%b\n' "$BLX_BOLD" "$BLX_RESET"
    printf '%s\n\n' 'Entender → detectar → verificar → decidir.'
    printf '%s\n' 'Unificar el acceso sin fusionar los proyectos.'
    printf '%s\n\n' 'Diagnósticos locales de solo lectura; IA opcional.'
}

blumix_help() {
    cat <<'HELP'
BLUMIX — Centro de Mando

Uso: blumix <comando>

Comandos:
  help, --help, -h       Mostrar esta ayuda
  menu                   Menú interactivo con selección segura
  watch [2-60]           Actualizar el centro de mando cada N segundos (Ctrl+C)
  completion bash        Generar autocompletado para Bash
  paths                  Mostrar rutas configuradas del ecosistema
  version, --version     Mostrar versión
  system                 Información básica del sistema
  network, net           Interfaces de red y DNS local
  security, sec           Estado detectable de firewall y SSH
  audit [--json]          Revisiones locales de permisos y archivos de riesgo
  policy [--json]         Catálogo de capacidades y límites de privilegio
  intelligence, intel     Diagnóstico accionable por reglas locales (solo lectura)
  projects [--json]       Inventario con estados de evidencia
  services [--json]       Procesos y unidades relacionados observables
  integrations, int      Rutas de proyectos conectados
  development, dev        Herramientas de desarrollo
  status                 Resumen breve del equipo e integraciones
  doctor                 Comprobaciones básicas de instalación
  report --json          Exportar instantánea local sin rutas ni secretos
  blumcl, cl              Abrir directorio BLUMCL
  blumsec                 Abrir directorio BLUMSEC
  blumelix, elx            Abrir directorio BLUMELIX
  about                  Filosofía del proyecto

Variables:
  BLUMCL_HOME, BLUMSEC_HOME, BLUMELIX_HOME
  BLUMIX_CONFIG          Ruta alternativa a la configuración local

Seguridad: los comandos de diagnóstico no modifican la configuración del sistema.
HELP
}

blumix_dashboard() {
    # Mantener la salida rápida y legible en pipes, logs y terminales pequeñas.
    if [[ ! -t 1 || "${BLUMIX_ANIM:-auto}" == "0" ]]; then
        export BLUMIX_ANIM=0
    fi
    if [[ -t 1 && "${BLUMIX_ANIM:-auto}" != "0" ]]; then
        blx_stars
        blx_matrix
    fi
    blx_ascii_art
    blx_title "BLUMIX // CENTRO DE MANDO"
    printf '  %bENTENDER%b → %bDETECTAR%b → %bVERIFICAR%b → %bDECIDIR%b\n' "$BLX_CYAN" "$BLX_RESET" "$BLX_BLUE" "$BLX_RESET" "$BLX_GREEN" "$BLX_RESET" "$BLX_MAGENTA" "$BLX_RESET"
    printf '  Modo: diagnóstico local · sin cambios automáticos\n\n'
    blx_stations
    blx_hud
    blumix_system
    blumix_integrations
    blumix_intelligence
    printf '\n'
    printf '  %bACCESO RÁPIDO%b\n' "$BLX_BOLD"
    printf '  blumix intelligence  Diagnóstico y siguientes pasos sugeridos\n'
    printf '  blumix doctor        Verificar instalación y rutas\n'
    printf '  blumix integrations  Inspeccionar proyectos\n'
    printf '  blumix security      Revisar señales de seguridad\n'
    printf '  blumix network       Consultar red y DNS\n'
    printf '  blumix report --json Exportar instantánea para el Atlas\n'
    printf '  blumix nave          Volver a mostrar este centro de mando\n'
    printf '\n  Atlas visual: docs/visual-atlas/index.html\n'
    printf '  La presencia de un directorio no confirma que un servicio esté activo.\n'
}

blumix_doctor() {
    local failures=0
    printf 'BLUMIX doctor — comprobaciones locales\n\n'
    for cmd in bash git awk sed; do
        if blumix_command_exists "$cmd"; then
            printf '[OK]      %s disponible\n' "$cmd"
        else
            printf '[FALTA]   %s no encontrado\n' "$cmd"
            failures=$((failures + 1))
        fi
    done
    for file in "$BLUMIX_ROOT/lib/core.sh" "$BLUMIX_ROOT/lib/ui.sh" "$BLUMIX_ROOT/lib/system.sh" "$BLUMIX_ROOT/lib/network.sh" "$BLUMIX_ROOT/lib/security.sh" "$BLUMIX_ROOT/lib/audit.sh" "$BLUMIX_ROOT/lib/policy.sh" "$BLUMIX_ROOT/lib/integrations.sh" "$BLUMIX_ROOT/lib/development.sh" "$BLUMIX_ROOT/lib/intelligence.sh" "$BLUMIX_ROOT/lib/evidence.sh"; do
        if [[ -r "$file" ]]; then
            printf '[OK]      %s\n' "${file#"$BLUMIX_ROOT/"}"
        else
            printf '[FALTA]   %s\n' "${file#"$BLUMIX_ROOT/"}"
            failures=$((failures + 1))
        fi
    done
    printf '\nRutas detectadas:\n'
    for pair in "BLUMCL:$BLUMCL_HOME" "BLUMSEC:$BLUMSEC_HOME" "BLUMELIX:$BLUMELIX_HOME"; do
        if [[ -d "${pair#*:}" ]]; then
            printf '[ENCONTRADO] %s\n' "$pair"
        else
            printf '[NO ENCONTRADO] %s (opcional; configura su ruta si corresponde)\n' "$pair"
        fi
    done
    if (( failures > 0 )); then
        printf '\nDoctor: %s comprobación(es) obligatoria(s) fallaron.\n' "$failures"
        return 1
    fi
    printf '\nDoctor: comprobaciones básicas superadas. No es una auditoría de seguridad completa.\n'
}


blumix_paths() {
    printf 'BLUMIX — RUTAS CONFIGURADAS (solo lectura)\n\n'
    printf 'Repositorio BLUMIX: %s\n' "$BLUMIX_ROOT"
    printf 'BLUMCL:   %s %s\n' "$([[ -d "$BLUMCL_HOME" ]] && printf '[OK]' || printf '[FALTA]')" "$BLUMCL_HOME"
    printf 'BLUMSEC:  %s %s\n' "$([[ -d "$BLUMSEC_HOME" ]] && printf '[OK]' || printf '[FALTA]')" "$BLUMSEC_HOME"
    printf 'BLUMELIX: %s %s\n' "$([[ -d "$BLUMELIX_HOME" ]] && printf '[OK]' || printf '[FALTA]')" "$BLUMELIX_HOME"
    printf '\nLas rutas se muestran localmente porque solicitaste este comando; no se exportan por defecto.\n'
}

blumix_completion() {
    [[ "${1:-}" == "bash" && -z "${2:-}" ]] || {
        printf 'Uso: blumix completion bash\n' >&2
        return 2
    }
    cat <<'COMPLETION'
_blumix_complete() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local commands="help version system network net security sec audit policy intelligence intel center projects services integrations int development dev status doctor report snapshot blumcl cl blumsec blumelix elx about nave menu watch completion paths"
    if (( COMP_CWORD == 1 )); then
        COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
    elif (( COMP_CWORD == 2 )); then
        case "${COMP_WORDS[1]}" in
            audit|policy|intelligence|intel|center|projects|services|report|snapshot)
                COMPREPLY=( $(compgen -W "--json" -- "$cur") ) ;;
            completion) COMPREPLY=( $(compgen -W "bash" -- "$cur") ) ;;
            watch) COMPREPLY=( $(compgen -W "2 5 10 15 30 60" -- "$cur") ) ;;
        esac
    fi
}
complete -F _blumix_complete blumix
COMPLETION
}

blumix_watch() {
    local interval="${2:-5}"
    if [[ ${1:-} != "watch" || ${3:-} != "" || ! "$interval" =~ ^[0-9]+$ ]] || (( interval < 2 || interval > 60 )); then
        printf 'Uso: blumix watch [intervalo-segundos: 2-60]\n' >&2
        return 2
    fi
    if [[ ! -t 1 ]]; then
        printf 'watch necesita una terminal interactiva; usa intelligence --json para salida automatizada.\n' >&2
        return 2
    fi
    trap 'printf "\033[0m\nBLUMIX watch detenido.\n"; return 0' INT
    while :; do
        printf '\033[H\033[2J'
        printf 'BLUMIX // CENTRO DE MANDO EN VIVO · refresco %ss · Ctrl+C para salir\n\n' "$interval"
        BLUMIX_ANIM=0 blumix_dashboard
        sleep "$interval"
    done
}

blumix_menu() {
    local choice
    [[ -t 0 && -t 1 ]] || { printf 'menu requiere una terminal interactiva.\n' >&2; return 2; }
    while :; do
        printf '\n%bBLUMIX // MENÚ DE OPERACIONES%b\n' "$BLX_CYAN" "$BLX_RESET"
        printf '  1) Centro de mando\n  2) Diagnóstico inteligente\n  3) Inventario de proyectos\n  4) Observación de servicios\n  5) Auditoría local\n  6) Seguridad\n  7) Red y DNS\n  8) Herramientas de desarrollo\n  9) Rutas configuradas\n  0) Salir\n'
        read -r -p 'Selecciona una opción: ' choice || return 0
        case "$choice" in
            1) blumix_dashboard ;;
            2) blumix_intelligence ;;
            3) blumix_projects text ;;
            4) blumix_services text ;;
            5) blumix_audit text ;;
            6) blumix_security ;;
            7) blumix_network ;;
            8) blumix_development ;;
            9) blumix_paths ;;
            0|q|Q) return 0 ;;
            *) printf 'Opción no válida; no se ejecutó ninguna acción.\n' ;;
        esac
        printf '\nPulsa Intro para volver al menú...'
        read -r _ || return 0
    done
}

case "${1:-}" in
    system) blumix_system ;;
    network|net) blumix_network ;;
    security|sec) blumix_security ;;
    policy)
        if [[ "${2:-}" == "--json" && -z "${3:-}" ]]; then
            blumix_policy json
        elif [[ -z "${2:-}" ]]; then
            blumix_policy text
        else
            printf 'Uso: blumix policy [--json]\n' >&2
            exit 2
        fi
        ;;
    audit)
        if [[ "${2:-}" == "--json" && -z "${3:-}" ]]; then
            blumix_audit json
        elif [[ -z "${2:-}" ]]; then
            blumix_audit text
        else
            printf 'Uso: blumix audit [--json]\n' >&2
            exit 2
        fi
        ;;
    integrations|int) blumix_integrations ;;
    paths)
        [[ -z "${2:-}" ]] || { printf 'Uso: blumix paths\\n' >&2; exit 2; }
        blumix_paths
        ;;
    completion) blumix_completion "${2:-}" "${3:-}" ;;
    watch) blumix_watch "$@" ;;
    menu) [[ -z "${2:-}" ]] || { printf 'Uso: blumix menu\\n' >&2; exit 2; }; blumix_menu ;;
    intelligence|intel|center)
        if [[ "${2:-}" == "--json" && -z "${3:-}" ]]; then blumix_intelligence_json
        elif [[ -z "${2:-}" ]]; then blumix_intelligence
        else printf "Uso: blumix intelligence [--json]\\n" >&2; exit 2; fi
        ;;
    projects)
        if [[ "${2:-}" == "--json" && -z "${3:-}" ]]; then blumix_projects json
        elif [[ -z "${2:-}" ]]; then blumix_projects text
        else printf "Uso: blumix projects [--json]\n" >&2; exit 2; fi
        ;;
    services)
        if [[ "${2:-}" == "--json" && -z "${3:-}" ]]; then blumix_services json
        elif [[ -z "${2:-}" ]]; then blumix_services text
        else printf "Uso: blumix services [--json]\n" >&2; exit 2; fi
        ;;
    development|dev) blumix_development ;;
    blumcl|cl) blumix_go_blumcl ;;
    blumsec) blumix_go_blumsec ;;
    blumelix|elx) blumix_go_blumelix ;;
    status) blumix_status ;;
    doctor) blumix_doctor ;;
    report|snapshot)
        if [[ "${2:-}" == "--json" && -z "${3:-}" ]]; then
            blumix_report_json
        else
            printf 'Uso: blumix report --json\n' >&2
            printf 'El informe no incluye rutas absolutas ni secretos.\n' >&2
            exit 2
        fi
        ;;
    about) blumix_about ;;
    nave) blumix_dashboard ;;
    version|--version|-V) printf 'BLUMIX %s\n' "$BLUMIX_VERSION" ;;
    help|--help|-h) blumix_help ;;
    "") blumix_dashboard ;;
    *)
        printf 'BLUMIX: comando desconocido: %s\n' "$1" >&2
        printf 'Ejecuta «blumix help» para ver los comandos.\n' >&2
        exit 2
        ;;
esac
