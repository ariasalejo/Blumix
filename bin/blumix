#!/usr/bin/env bash
# 🌌 BLUMIX ULTRA · Nave + Estaciones
set -o pipefail
BLUMIX_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$BLUMIX_ROOT/lib/core.sh"
source "$BLUMIX_ROOT/lib/ui.sh"
source "$BLUMIX_ROOT/lib/system.sh"
source "$BLUMIX_ROOT/lib/network.sh"
source "$BLUMIX_ROOT/lib/security.sh"
source "$BLUMIX_ROOT/lib/development.sh"
source "$BLUMIX_ROOT/lib/integrations.sh"
blumix_load_config

blumix_status() {
    local cpu=$(blx_cpu_pct)
    local ram=$(free 2>/dev/null | awk '/^Mem:/ {printf "%.0f", ($3/$2)*100}')
    local disk=$(df -h / 2>/dev/null | awk 'NR==2 {gsub("%","",$5); print $5}')
    local cl="🔴" sec="🔴" elx="🔴"
    blumix_dir_exists "$BLUMCL_HOME" && cl="🟢"
    blumix_dir_exists "$BLUMSEC_HOME" && sec="🟢"
    blumix_dir_exists "$BLUMELIX_HOME" && elx="🟢"
    printf 'BLUMIX v%s | CPU %s%% | RAM %s%% | DISK %s%% | CL %s SEC %s ELX %s\n' \
        "$BLUMIX_VERSION" "$cpu" "${ram:-?}" "${disk:-?}" "$cl" "$sec" "$elx"
}

blumix_about() {
    printf '\n%b💎 BLUMIX%b — Centro de Mando\n\n' "$BLX_BOLD" "$BLX_RESET"
    cat <<'TXT'
Este proyecto es para mí, Eduar.
Para recordarme cada día que todo es posible si no me rindo.
Porque cada línea de código es una prueba de que puedo.

— Eduar Arias · 14 de agosto de 2026
TXT
    printf '\n'
}

blumix_dashboard() {
    clear 2>/dev/null
    blx_matrix
    blx_stars
    blx_ascii_art
    blx_glitch "  >> NAVE ESPACIAL EN LÍNEA <<"
    blx_stations
    blx_hud
    blx_spin "Escaneando integraciones BLUM..."
    local user="${USER:-$(whoami)}"
    local st="🔴 offline"
    curl -s -m 1 http://127.0.0.1:5000 2>/dev/null | grep -q "BLUMELIX" && st="🟢 en línea"
    printf '\n'
    blx_typing "  👤 ${user} · 💎 Blumelix ${st} · $(date +%d/%m/%Y' '%H:%M)"
    printf '\n  %bsystem%b·%bnetwork%b·%bsecurity%b·%bintegrations%b·%bdevelopment%b·%bstatus%b·%babout%b\n\n' \
      "$BLX_GREEN" "$BLX_RESET" "$BLX_GREEN" "$BLX_RESET" "$BLX_GREEN" "$BLX_RESET" "$BLX_GREEN" "$BLX_RESET" "$BLX_GREEN" "$BLX_RESET" "$BLX_GREEN" "$BLX_RESET" "$BLX_GREEN" "$BLX_RESET"
}

case "${1:-}" in
    system) blumix_system ;; network) blumix_network ;; security) blumix_security ;;
    integrations) blumix_integrations ;; development) blumix_development ;;
    blumcl) blumix_go_blumcl ;; blumsec) blumix_go_blumsec ;; blumelix) blumix_go_blumelix ;;
    status) blumix_status ;; about) blumix_about ;; nave|"") blumix_dashboard ;;
    version) echo "Blumix $BLUMIX_VERSION" ;; help) blumix_dashboard ;;
esac
